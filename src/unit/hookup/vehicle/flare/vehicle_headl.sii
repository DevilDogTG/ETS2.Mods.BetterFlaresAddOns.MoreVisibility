SiiNunit
{
flare_vehicle: flare.vehicle.headl
{
	dir_type: angle
	flare_inner_angle: 90 # flare visibility cone
	flare_outer_angle: 110 # flare fade out cone
	light_type: low_beam

	model: "/model/flare/bf_75.pmd"
	visual_offset: 1.0
	default_scale: 1.84
	scale_factor: 3.85
	scaling_start_distance: 0
	scaling_end_distance: 80

@include "vehicle_bulb_type_incandescent.sui"
}
}
