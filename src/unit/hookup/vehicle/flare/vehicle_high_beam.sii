SiiNunit
{
flare_vehicle: flare.vehicle.high_beam
{
	dir_type: angle
	flare_inner_angle: 80 # flare visibility cone
	flare_outer_angle: 110 # flare fade out cone
	light_type: high_beam

	model: "/model/flare/bf_75.pmd"
	visual_offset: 0.8
	default_scale: 2.07
	scale_factor: 4.4
	scaling_start_distance: 0
	scaling_end_distance: 80

@include "vehicle_bulb_type_incandescent.sui"
}
}
